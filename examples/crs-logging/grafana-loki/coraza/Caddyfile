# Caddy + Coraza + OWASP CRS, for the CRS logging series (Part 3).
#
# The coraza-crs image generates a Caddyfile from environment variables, but
# that one sends Caddy's log (which is where Coraza writes its alerts) to
# stderr. This file replaces it (mounted at /config/caddy/Caddyfile) so that
# the log goes to a file Grafana Alloy can tail. The include chain below is
# the image's own, minus the plugin directories this lab does not use.

{
	order coraza_waf first

	# Caddy's own log. Coraza's rule matches go through the logger
	# "http.handlers.waf"; everything else here is Caddy housekeeping.
	# Level INFO: Coraza logs CRITICAL and ERROR matches at "error", WARNING
	# matches and blocking decisions at "warn", NOTICE matches at "info".
	log {
		output file /var/log/coraza/caddy.log
		format json {
			time_format rfc3339_nano
		}
		level INFO
	}

	# Take the client address from X-Forwarded-For when the request comes
	# from a trusted proxy, so Coraza sees (and logs) the real client. The
	# lab trusts the private ranges and Tailscale's 100.64.0.0/10 because the
	# traffic generator fakes client addresses; in production list your load
	# balancers and nothing else. Same policy as ../../waf/nginx-realip.conf.
	servers {
		trusted_proxies static private_ranges 100.64.0.0/10
		client_ip_headers X-Forwarded-For
	}
}

:8080 {
	coraza_waf {
		# Generated by the image from the CORAZA_* environment variables
		include /opt/coraza/config/coraza.conf
		include /opt/coraza/config.d/*.conf

		# CRS setup, generated from BLOCKING_PARANOIA, DETECTION_PARANOIA, ...
		include /opt/coraza/config/crs-setup.conf

		# CRS
		include /opt/coraza/owasp-crs/rules/*.conf

		# Our rules: the CRS score summary and the audit log relevance rule
		include /opt/coraza/rules.d/*.conf
	}

	reverse_proxy backend:80
}
