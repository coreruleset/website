    {
      "id": 41,
      "type": "timeseries",
      "title": "Highest inbound anomaly score per interval (summary rule)",
      "description": "Comes from the custom phase 5 summary rule (id 99901); Coraza also logs CRS's own report, rule 980170. The detection score includes rules above the blocking paranoia level: the gap between the two lines is what a higher paranoia level would have caught.",
      "gridPos": {
        "x": 12,
        "y": 32,
        "w": 12,
        "h": 9
      },
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "max(max_over_time({job=\"waf-alerts\", event=\"summary\"} | unwrap inbound_blocking [$__auto]))",
          "legendFormat": "blocking PL score",
          "queryType": "range"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "max(max_over_time({job=\"waf-alerts\", event=\"summary\"} | unwrap inbound_detection [$__auto]))",
          "legendFormat": "detection PL score",
          "queryType": "range"
        },
        {
          "refId": "C",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "max(max_over_time({job=\"waf-alerts\", event=\"summary\"} | unwrap inbound_threshold [$__auto]))",
          "legendFormat": "threshold",
          "queryType": "range"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "unit": "short",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 0,
            "spanNulls": true,
            "pointSize": 4,
            "showPoints": "auto"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "threshold"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "red"
                }
              },
              {
                "id": "custom.lineStyle",
