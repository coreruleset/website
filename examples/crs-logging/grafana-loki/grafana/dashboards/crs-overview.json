{
  "uid": "crs-coraza-overview",
  "title": "OWASP CRS - Coraza overview",
  "description": "What the WAF is seeing: rule matches, blocked requests, attack categories, anomaly scores, and the raw logs. Built for the OWASP CRS logging blog series.",
  "tags": [
    "owasp",
    "crs",
    "coraza",
    "waf"
  ],
  "timezone": "browser",
  "editable": true,
  "graphTooltip": 1,
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "refresh": "30s",
  "schemaVersion": 39,
  "templating": {
    "list": [
      {
        "name": "attack",
        "label": "Attack category",
        "type": "query",
        "datasource": {
          "type": "loki",
          "uid": "loki"
        },
        "definition": "label_values({job=\"waf-alerts\"}, attack)",
        "query": {
          "label": "attack",
          "refId": "LokiVariableQueryEditor-VariableQuery",
          "stream": "{job=\"waf-alerts\"}",
          "type": 1
        },
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "refresh": 2,
        "sort": 1
      },
      {
        "name": "rule_id",
        "label": "Rule ID",
        "type": "query",
        "datasource": {
          "type": "loki",
          "uid": "loki"
        },
        "definition": "label_values({job=\"waf-alerts\"}, rule_id)",
        "query": {
          "label": "rule_id",
          "refId": "LokiVariableQueryEditor-VariableQuery",
          "stream": "{job=\"waf-alerts\"}",
          "type": 1
        },
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "refresh": 2,
        "sort": 3
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Rule matches",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "sum(count_over_time({job=\"waf-alerts\", event=\"alert\", attack=~\"$attack\", rule_id=~\"$rule_id\"}[$__range]))",
          "queryType": "instant",
          "instant": true,
          "range": false
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
